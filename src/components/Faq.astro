---
import { business } from '../data/business';
import Tbc from './Tbc.astro';
import Photo from './Photo.astro';
const b = business;
// `a: null` → shows a TBC placeholder until Jono confirms the answer.
const faqs: { q: string; a: string | null }[] = [
  { q: 'Will servicing with you void my new-car warranty?', a: 'No. Under Australian Consumer Law you can have your car serviced by an independent mechanic without voiding the manufacturer’s warranty, as long as the work follows the manufacturer’s schedule and uses suitable parts. We service to the book and stamp your logbook.' },
  { q: 'Will you do work I haven’t approved?', a: 'Never. If we find something extra, we ring you first with what it is, what it costs and whether it can wait. Nothing gets done until you say yes.' },
  { q: 'How much will it cost?', a: 'We’ll give you a straight quote once we’ve had a look. Our rates are the same whether you booked weeks ago or you’re stranded today.' },
  { q: 'Do I need to book, or can I just turn up?', a: null },
  { q: 'Do you work on old cars?', a: 'Do we ever. Honestly, we love them a bit too much. Bring in your old girl and we’ll be finding excuses to keep her an extra day just to admire her. (We won’t actually. Probably.) Classics, muscle cars, the family wagon that’s older than you: bring it in.' },
  { q: 'Can you look after my business fleet?', a: 'Yes. Plenty of local tradies and businesses run their vans and utes through us. Give Jono a ring to set it up.' },
  { q: 'What are your hours?', a: `${b.hours.map(([d, h]) => `${d}: ${h}`).join(' · ')}.` },
  { q: 'Do you offer a loan car, or pick-up and drop-off?', a: b.loanCars || b.pickup ? [b.loanCars, b.pickup].filter(Boolean).join(' ') : null },
  { q: 'How can I pay?', a: b.payment },
  { q: 'Is your work guaranteed?', a: b.warranty },
  { q: 'Are you licensed?', a: b.licence ? `Yes. Licence no. ${b.licence}${b.abn ? ` · ABN ${b.abn}` : ''}.` : null },
  { q: 'How long have you been around?', a: b.yearsInBusiness },
  { q: 'Are you a member of any industry bodies?', a: b.memberships?.join(', ') ?? null },
];
---
<section id="faq" class="bg-paper-2/45">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-24 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <h2 class="font-display text-[clamp(2.2rem,4.2vw,3.5rem)] font-black uppercase leading-[0.9]">Fair questions.</h2>
      <p class="mt-5 max-w-sm text-ink/70">Something else? Ring <a href={b.phoneHref} class="font-semibold underline decoration-carmine decoration-2 underline-offset-4">{b.phone}</a>.</p>
      <Photo src={b.photos.faq} alt="Classic cars in the Ferny Grove Mechanical workshop" label="Workshop photo" class="mt-8 hidden aspect-[4/3] w-full rounded-3xl lg:block" />
    </div>
    <div class="divide-y divide-ink/10 rounded-3xl bg-paper px-6">
      {faqs.map((f, i) => (
        <details class="group py-5" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold">
            {f.q}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-paper-2 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="mt-3 max-w-2xl text-ink/70">{f.a ?? <Tbc label="Answer" />}</div>
        </details>
      ))}
    </div>
  </div>
</section>
