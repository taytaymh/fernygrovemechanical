---
import Base from '../layouts/Base.astro';
import HoodScroll from '../components/HoodScroll.astro';
import Reviews from '../components/Reviews.astro';
import Process from '../components/Process.astro';
import Fleet from '../components/Fleet.astro';
import Photo from '../components/Photo.astro';
import LogoIcon from '../components/LogoIcon.astro';
import Faq from '../components/Faq.astro';
import Book from '../components/Book.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import Tbc from '../components/Tbc.astro';
import { business } from '../data/business';
import { getReviews } from '../lib/google-reviews';

const reviews = await getReviews();

const { phone: PHONE, phoneHref: PHONE_HREF } = business;

const promises = [
  { n: '01', t: 'We call before we spend.', d: "Nothing gets done that you haven't said yes to. If we find something extra, you hear about it first, with a photo." },
  { n: '02', t: 'What can wait, waits.', d: "We'll tell you what needs doing now, what's worth doing soon, and what's fine for another year." },
  { n: '03', t: 'Bad day? Same price.', d: 'Broken down, stranded, desperate. Our rates don’t change because you’re having a rough one.' },
  { n: '04', t: 'Done when we said.', d: "If it's ready Thursday, it's ready Thursday. If something changes, we ring you, not the other way round." },
];
---
<Base title="Ferny Grove Mechanical | The best bang for your buck in Brisbane" description="Independent mechanic in Everton Hills, Brisbane. Fixed right and priced fair, with no fuss along the way.">
  <!-- Header -->
  <header class="fixed inset-x-0 top-0 z-50 bg-teal text-paper shadow-[0_6px_24px_-12px_rgba(29,32,31,0.45)]">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-3 px-4 sm:px-5">
      <!-- icon height = cap height of the wordmark (Big Shoulders caps ≈ 0.7em) -->
      <a href="/" class="flex items-center gap-[0.3em] whitespace-nowrap font-logo text-[1.15rem] font-extrabold uppercase leading-none tracking-[0.01em] text-paper min-[400px]:text-[1.3rem] sm:text-[1.6rem] md:text-[1.9rem]" aria-label="Ferny Grove Mechanical home">
        <LogoIcon class="h-[0.7em] w-auto shrink-0" />
        <span class="translate-y-[0.04em]">Ferny Grove Mechanical</span>
      </a>
      <nav class="hidden gap-8 font-sans text-[15px] md:flex">
        <a href="#services" class="text-paper/85 transition hover:text-paper">Services</a>
        <a href="#reviews" class="text-paper/85 transition hover:text-paper">Reviews</a>
        <a href="#fleet" class="text-paper/85 transition hover:text-paper">Fleet</a>
        <a href="#faq" class="text-paper/85 transition hover:text-paper">FAQ</a>
        <a href="#find-us" class="text-paper/85 transition hover:text-paper">Find us</a>
      </nav>
      <div class="flex items-center gap-4">
        <a href={PHONE_HREF} class="hidden font-sans text-[15px] text-paper/90 hover:text-paper sm:block">{PHONE}</a>
        <a href="#book" class="shrink-0 whitespace-nowrap rounded-full bg-carmine px-3.5 py-2 font-sans text-sm sm:px-4 sm:text-[15px] font-semibold text-paper transition hover:bg-paper hover:text-ink">Book in</a>
      </div>
    </div>
  </header>

  <main>
    <HoodScroll rating={reviews.rating} count={reviews.count} isSample={reviews.isSample} />
    <Reviews data={reviews} />
    <Process />

    <!-- How we work -->
    <section id="how" class="bg-ink text-paper">
      <div class="mx-auto max-w-7xl px-5 py-24">
        <!-- motto, beside the people who live by it -->
        <figure class="mb-20 grid gap-10 border-b border-white/15 pb-20 lg:grid-cols-[1.5fr_1fr] lg:items-end">
          <div>
            <blockquote class="max-w-[18ch] font-display text-[clamp(2.8rem,6.5vw,6rem)] font-black uppercase leading-[0.88]">
              We don't like to profit off of the misfortune of others.
            </blockquote>
            <p class="mt-8 max-w-2xl text-xl leading-relaxed text-paper/75">
              That's the motto that guides our work. It's not in our nature to try and upsell you, or charge you more based off how much we think we can fool you. We are in the business of doing good work and providing the best outcome possible for our customers.
            </p>
          </div>
          <figcaption>
            <Photo src={business.team[0].photo} alt="The owner with a customer's Holden, hood up" label="Photo of Jono" dark class="aspect-[4/5] w-full rounded-3xl object-[28%_center]" />
          </figcaption>
        </figure>

        <div class="grid gap-12 lg:grid-cols-[1fr_1.6fr]">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <h2 class="font-display text-[clamp(2.2rem,4.2vw,3.5rem)] font-black uppercase leading-[0.9]">Four promises.<br />No fine print.</h2>
          </div>
          <ol class="divide-y divide-white/15 [&>li:first-child]:pt-0 [&>li:last-child]:pb-0">
            {promises.map((p) => (
              <li class="group py-8">
                <div>
                  <h3 class="font-display text-3xl font-extrabold transition group-hover:text-carmine-bright">{p.t}</h3>
                  <p class="mt-2 max-w-xl text-lg text-paper/70">{p.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <Fleet />
    <Faq />
    <Book />
  </main>

  <footer class="border-t border-ink/10 bg-paper pb-24 md:pb-0">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 py-8 text-sm text-ink/60">
      <img src="/logo-wordmark-ink.png" alt="FG Mech" class="h-8 w-auto" />
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>{business.address}</span>
        <span aria-hidden="true">·</span>
        <span>ABN {business.abn ?? <Tbc label="ABN" />}</span>
        <span aria-hidden="true">·</span>
        <span>© {new Date().getFullYear()} {business.name}</span>
      </p>
    </div>
  </footer>
  <MobileCallBar />
</Base>
